include                  
    styles.conf
passwords                [this item cannot be displayed]
log                      ""
loglevel                 4
conlog                   1
binlog                   ""
fdinhist                 ""
fdouthist                ""
tzoff                    -1s
domain                   
    fidonet ./outb 2
address                  
    2:5047/13@fidonet
sysname                  "Test"
bindaddr                 ""
listen                   [this item cannot be displayed]
sysop                    "Test"
location                 "Test"
nodeinfo                 "Test"
iport                    "binkp"
oport                    "binkp"
rescan-delay             1m
call-delay               1m
timeout                  5m
oblksize                 4096
maxservers               100
maxclients               100
inbound                  "in"
inbound-nonsecure        "in"
temp-inbound             ""
node                     
defnode                  <not defined>
kill-dup-partial-files   <not defined>
kill-old-partial-files   0s
kill-old-bsy             0s
percents                 <not defined>
minfree                  -1
minfree-nonsecure        -1
flag                     
exec                     
printq                   <not defined>
try                      0
hold                     0s
hold-skipped             1h
backresolv               <not defined>
pid-file                 ""
remove-try-files         <not defined>
syslog                   [this item cannot be displayed]
ftrans                   
send-if-pwd              <not defined>
root-domain              "binkp.net"
prescan                  <not defined>
connect-timeout          0s
filebox                  ""
brakebox                 ""
deletebox                <not defined>
skip                     
    all !10 "*.pkt"
skipmask                 
    all !10 "*.pkt"
inboundcase              upper
deletedirs               <not defined>
overwrite                
dont-send-empty          [this item cannot be displayed]
rename-style             extenstion
share                    
check-pkthdr             secure xyz
nolog                    
hide-aka                 
    [see present-aka]
present-aka              
zlevel                   0
zminsize                 1024
zallow                   
    zallow *
zdeny                    
    [see zallow]
